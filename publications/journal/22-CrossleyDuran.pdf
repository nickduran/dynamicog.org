         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The action dynamics of native and non-native speakers of English in processing active and passive sentences</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Scott Crossley, Nicholas D. Duran, YouJin Kim, Tiffany Lester and Samuel Clark</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>second language acquisition</rdf:li>
               <rdf:li>syntactic processing</rdf:li>
               <rdf:li>action dynamics</rdf:li>
               <rdf:li>mouse tracking</rdf:li>
            </rdf:Bag>
         </dc:subject>
