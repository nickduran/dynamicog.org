---
layout: default
---

{% comment %}
  Local override of al_folio_core's about.liquid (spec §6).
  Home page = research statement: hero block, then theme rows from _data/themes.yml.
  All copy comes from _pages/about.md front matter and _data/themes.yml; only the
  link-row labels and the headshot alt text are literal here. Styling: assets/css/main.scss (.dc-hero*, .dc-theme*, .dc-tile*).
  The gem's news / latest-posts / selected-papers / social / newsletter blocks are
  intentionally omitted: the page's flags are all false and the spec removes them.
{% endcomment %}

{% assign socials = site.data.socials %}

<section class="dc-hero">
  <div class="dc-hero__band">
    <p class="dc-hero__eyebrow">
      {{- page.eyebrow -}}
      {%- if page.eyebrow_sub -%}
        <span class="dc-hero__eyebrow-sep">·</span><span class="dc-hero__eyebrow-sub">{{ page.eyebrow_sub }}</span>
      {%- endif -%}
    </p>
    <h1 class="dc-hero__headline">{{ page.headline }} <em class="dc-hero__accent">{{ page.headline_accent }}</em></h1>
  </div>

  <div class="dc-hero__body">
    <p class="dc-hero__lede">{{ page.lede }}</p>
    <p class="dc-hero__methods">{% for m in page.methods %}<span class="dc-hero__method">{{ m }}</span>{% unless forloop.last %}<span class="dc-hero__sep"> · </span>{% endunless %}{% endfor %}</p>
    <ul class="dc-hero__links">
      {% if socials.email %}
        <li><a href="mailto:{{ socials.email }}"><i class="fa-solid fa-envelope" aria-hidden="true"></i>Email</a></li>
      {% endif %}
      {% if socials.scholar_userid %}
        <li><a href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}" target="_blank" rel="noopener"><i class="ai ai-google-scholar" aria-hidden="true"></i>Google Scholar</a></li>
      {% endif %}
      {% if socials.github_username %}
        <li><a href="https://github.com/{{ socials.github_username }}" target="_blank" rel="noopener"><i class="fa-brands fa-github" aria-hidden="true"></i>GitHub</a></li>
      {% endif %}
      {% if socials.orcid_id %}
        <li><a href="https://orcid.org/{{ socials.orcid_id }}" target="_blank" rel="noopener"><i class="ai ai-orcid" aria-hidden="true"></i>ORCID</a></li>
      {% endif %}
    </ul>
    {% if page.recruiting and page.recruiting.enabled %}
      <p class="dc-hero__recruiting">{{ page.recruiting.text }} <a href="{{ page.recruiting.link | relative_url }}">{{ page.recruiting.link_text }}</a></p>
    {% endif %}
  </div>

  <div class="dc-hero__photo">
    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {% include figure.liquid loading="eager" path=profile_image_path class="dc-hero__img" alt="Nick Duran" cache_bust=true %}
    {% endif %}
    {% if page.director %}
      <p class="dc-hero__director">{{ page.director | join: "<br>" }}</p>
    {% endif %}
  </div>
</section>

{{ content }}

<section class="dc-themes" id="research">
  {% for theme in site.data.themes %}
    {% include theme-row.liquid theme=theme %}
  {% endfor %}
</section>
